{
  "info": {
    "name": "SLIIT Peer — Authentication, Profiles and Permissions",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run all requests in order, once. Creates a temporary account and removes it in requests 11–12. API testing only; does not certify UI, bookings or human usability."
  },
  "item": [
    {
      "name": "01 Register a temporary student",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "https://identitytoolkit.googleapis.com/v1/accounts:signUp?key={{apiKey}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"returnSecureToken\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.environment.set('testEmail','postman-audit-'+Date.now()+'@my.sliit.lk');pm.environment.set('createdAt',new Date().toISOString());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 expected', () => pm.response.to.have.status(200));",
              "if(pm.response.code===200){const d=pm.response.json();pm.environment.set('idToken',d.idToken);pm.environment.set('uid',d.localId);}"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Create own pending profile",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{idToken}}"
          }
        ],
        "url": "https://firestore.googleapis.com/v1/projects/{{projectId}}/databases/(default)/documents/users/{{uid}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fields\": {\n    \"name\": {\n      \"stringValue\": \"Postman Audit Student\"\n    },\n    \"email\": {\n      \"stringValue\": \"{{testEmail}}\"\n    },\n    \"role\": {\n      \"stringValue\": \"tutee\"\n    },\n    \"year\": {\n      \"stringValue\": \"Year 2\"\n    },\n    \"program\": {\n      \"stringValue\": \"Information Technology\"\n    },\n    \"verificationStatus\": {\n      \"stringValue\": \"pending\"\n    },\n    \"verificationEvidence\": {\n      \"nullValue\": null\n    },\n    \"guidelinesAccepted\": {\n      \"booleanValue\": false\n    },\n    \"pledgeAccepted\": {\n      \"booleanValue\": true\n    },\n    \"pledgeAcceptedAt\": {\n      \"timestampValue\": \"{{createdAt}}\"\n    },\n    \"createdAt\": {\n      \"timestampValue\": \"{{createdAt}}\"\n    }\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 expected', () => pm.response.to.have.status(200));",
              ""
            ]
          }
        }
      ]
    },
    {
      "name": "03 Read own profile",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{idToken}}"
          }
        ],
        "url": "https://firestore.googleapis.com/v1/projects/{{projectId}}/databases/(default)/documents/users/{{uid}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 expected', () => pm.response.to.have.status(200));",
              "pm.test('Own email matches',()=>pm.expect(pm.response.json().fields.email.stringValue).to.eql(pm.environment.get('testEmail')));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Update profile name",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{idToken}}"
          }
        ],
        "url": "https://firestore.googleapis.com/v1/projects/{{projectId}}/databases/(default)/documents/users/{{uid}}?updateMask.fieldPaths=name",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fields\": {\n    \"name\": {\n      \"stringValue\": \"Postman Updated Student\"\n    }\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 expected', () => pm.response.to.have.status(200));",
              ""
            ]
          }
        }
      ]
    },
    {
      "name": "05 Fresh login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "https://identitytoolkit.googleapis.com/v1/accounts:signInWithPassword?key={{apiKey}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"returnSecureToken\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 expected', () => pm.response.to.have.status(200));",
              "if(pm.response.code===200){const d=pm.response.json();pm.environment.set('idToken',d.idToken);pm.environment.set('uid',d.localId);}"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Verify persisted profile",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{idToken}}"
          }
        ],
        "url": "https://firestore.googleapis.com/v1/projects/{{projectId}}/databases/(default)/documents/users/{{uid}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 expected', () => pm.response.to.have.status(200));",
              "pm.test('Updated name persists',()=>pm.expect(pm.response.json().fields.name.stringValue).to.eql('Postman Updated Student'));"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Student cannot list all users",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{idToken}}"
          }
        ],
        "url": "https://firestore.googleapis.com/v1/projects/{{projectId}}/databases/(default)/documents/users?pageSize=1"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('403 expected', () => pm.response.to.have.status(403));",
              ""
            ]
          }
        }
      ]
    },
    {
      "name": "08 Student cannot self approve",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{idToken}}"
          }
        ],
        "url": "https://firestore.googleapis.com/v1/projects/{{projectId}}/databases/(default)/documents/users/{{uid}}?updateMask.fieldPaths=verificationStatus",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fields\": {\n    \"verificationStatus\": {\n      \"stringValue\": \"approved\"\n    }\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('403 expected', () => pm.response.to.have.status(403));",
              ""
            ]
          }
        }
      ]
    },
    {
      "name": "09 Unauthenticated profile read denied",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "https://firestore.googleapis.com/v1/projects/{{projectId}}/databases/(default)/documents/users/{{uid}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('403 expected', () => pm.response.to.have.status(403));",
              ""
            ]
          }
        }
      ]
    },
    {
      "name": "10 Administrator login for cleanup",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "https://identitytoolkit.googleapis.com/v1/accounts:signInWithPassword?key={{apiKey}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\",\n  \"returnSecureToken\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 expected', () => pm.response.to.have.status(200));",
              "if(pm.response.code===200)pm.environment.set('adminToken',pm.response.json().idToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "11 Delete ONLY temporary profile",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": "https://firestore.googleapis.com/v1/projects/{{projectId}}/databases/(default)/documents/users/{{uid}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 expected', () => pm.response.to.have.status(200));",
              ""
            ]
          }
        }
      ]
    },
    {
      "name": "12 Delete temporary authentication account",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "https://identitytoolkit.googleapis.com/v1/accounts:delete?key={{apiKey}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"idToken\": \"{{idToken}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 expected', () => pm.response.to.have.status(200));",
              "if(pm.response.code===200){['idToken','adminToken','uid'].forEach(k=>pm.environment.unset(k));}"
            ]
          }
        }
      ]
    }
  ]
}