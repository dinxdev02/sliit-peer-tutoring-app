rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && request.auth.token.admin == true && request.auth.token.email == 'assignment-admin@my.sliit.lk'; }
    function own(id) { return signedIn() && request.auth.uid == id; }
    function member(b) { return signedIn() && request.auth.uid in b.participants; }
    function user(id) { return get(/databases/$(database)/documents/users/$(id)).data; }
    function booking(id) { return getAfter(/databases/$(database)/documents/bookings/$(id)).data; }
    function slot(id) { return getAfter(/databases/$(database)/documents/availability/$(id)).data; }
    match /users/{uid} {
      allow read: if own(uid) || admin();
      allow create: if own(uid) && request.resource.data.keys().hasOnly(['name','email','role','year','program','verificationStatus','verificationEvidence','guidelinesAccepted','createdAt','pledgeAccepted','pledgeAcceptedAt'])
        && (!('pledgeAccepted' in request.resource.data) || request.resource.data.pledgeAccepted == true && request.resource.data.pledgeAcceptedAt is timestamp)
        && request.resource.data.verificationStatus == 'pending' && request.resource.data.role in ['tutee','tutor']
        && request.resource.data.name is string && request.resource.data.name.size() >= 2
        && request.resource.data.email == request.auth.token.email && request.resource.data.email.matches('.*@my[.]sliit[.]lk')
        && request.resource.data.guidelinesAccepted == false;
      allow update: if admin() || own(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','year','program','role','guidelinesAccepted'])
        && request.resource.data.role in ['tutee','tutor'] && request.resource.data.name is string && request.resource.data.name.size() >= 2;
      allow delete: if admin();
      match /favorites/{tutorId} {
        allow read, delete: if own(uid);
        allow create, update: if own(uid) && request.resource.data.keys().hasOnly(['tutorId','createdAt','note'])
          && (!('note' in request.resource.data) || request.resource.data.note is string && request.resource.data.note.size() <= 300)
          && request.resource.data.tutorId == tutorId && get(/databases/$(database)/documents/tutorProfiles/$(tutorId)).data.verified == true;
      }
    }
    match /tutorProfiles/{uid} {
      allow read: if signedIn() && (own(uid) || admin() || resource.data.verified == true);
      allow create, update: if admin() || own(uid) && request.resource.data.keys().hasOnly(['userId','name','year','program','subjects','bio','verified'])
        && request.resource.data.userId == uid && request.resource.data.verified == (user(uid).verificationStatus == 'approved')
        && request.resource.data.subjects is list && request.resource.data.subjects.size() > 0
        && request.resource.data.bio is string && request.resource.data.bio.size() > 0 && request.resource.data.bio.size() <= 250;
      allow delete: if own(uid) || admin();
    }
    match /availability/{id} {
      allow read: if signedIn();
      allow create: if own(request.resource.data.tutorId) && user(request.auth.uid).role == 'tutor'
        && request.resource.data.keys().hasOnly(['tutorId','start','end','mode','venue','available','bookingId'])
        && request.resource.data.start is timestamp && request.resource.data.start > request.time
        && request.resource.data.end > request.resource.data.start && request.resource.data.mode in ['Campus','Online']
        && request.resource.data.venue is string && request.resource.data.available == true && request.resource.data.bookingId == null;
      allow update: if admin() || signedIn() && (
        own(resource.data.tutorId) && resource.data.bookingId == null && request.resource.data.bookingId == null
          && request.resource.data.tutorId == resource.data.tutorId && request.resource.data.start == resource.data.start
          && request.resource.data.end > request.resource.data.start && request.resource.data.mode in ['Campus','Online']
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bookingId']) && (
          resource.data.bookingId == null && request.resource.data.bookingId is string
            && booking(request.resource.data.bookingId).slotId == id && member(booking(request.resource.data.bookingId))
            && booking(request.resource.data.bookingId).status == 'pending'
          || resource.data.bookingId is string && request.resource.data.bookingId == null
            && member(booking(resource.data.bookingId)) && (booking(resource.data.bookingId).status in ['cancelled','declined','completed']
              || booking(resource.data.bookingId).slotId != id)));
      allow delete: if own(resource.data.tutorId) && resource.data.bookingId == null || admin();
    }
    match /bookings/{id} {
      allow read: if member(resource.data) || admin();
      function matchesSlot(b) { return slot(b.slotId).tutorId == b.tutorId && slot(b.slotId).start == b.start
        && slot(b.slotId).end == b.end && slot(b.slotId).mode == b.mode && slot(b.slotId).venue == b.venue
        && slot(b.slotId).available == true && slot(b.slotId).bookingId == id; }
      allow create: if own(request.resource.data.tuteeId) && request.resource.data.tutorId != request.auth.uid
        && request.resource.data.keys().hasOnly(['tutorId','tuteeId','participants','tutorName','tuteeName','module','slotId','start','end','mode','venue','notes','teamsUrl','status','createdAt'])
        && request.resource.data.participants == [request.resource.data.tutorId, request.auth.uid]
        && request.resource.data.tuteeName == user(request.auth.uid).name && user(request.auth.uid).guidelinesAccepted == true
        && request.resource.data.status == 'pending' && request.resource.data.start > request.time
        && get(/databases/$(database)/documents/tutorProfiles/$(request.resource.data.tutorId)).data.verified == true
        && request.resource.data.module in get(/databases/$(database)/documents/tutorProfiles/$(request.resource.data.tutorId)).data.subjects
        && matchesSlot(request.resource.data) && request.resource.data.notes is string && request.resource.data.notes.size() <= 500;
      allow update: if member(resource.data) && (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt','teamsUrl']) && (
          request.resource.data.status == 'cancelled' && resource.data.status in ['pending','confirmed']
            && (own(resource.data.tutorId) || resource.data.status == 'pending')
          || own(resource.data.tutorId) && resource.data.status == 'pending' && request.resource.data.status in ['confirmed','declined']
          || own(resource.data.tutorId) && resource.data.status == 'confirmed' && request.resource.data.status == 'completed' && resource.data.end <= request.time)
        || own(resource.data.tuteeId) && resource.data.status == 'pending' && request.resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['slotId','start','end','mode','venue','status','teamsUrl','updatedAt'])
          && request.resource.data.start > request.time && matchesSlot(request.resource.data));
      allow delete: if admin();
    }
    match /reviews/{id} {
      allow read: if signedIn();
      allow create, update: if own(request.resource.data.tuteeId) && request.resource.data.bookingId == id
        && booking(id).tuteeId == request.auth.uid && booking(id).tutorId == request.resource.data.tutorId && booking(id).status == 'completed'
        && request.resource.data.keys().hasOnly(['bookingId','tutorId','tuteeId','author','rating','comment','tags','createdAt'])
        && request.resource.data.rating is number && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.comment is string && request.resource.data.comment.size() <= 300 && request.resource.data.author == user(request.auth.uid).name;
      allow delete: if own(resource.data.tuteeId) || admin();
    }
    match /chats/{id} {
      allow get: if signedIn() && (!exists(/databases/$(database)/documents/chats/$(id)) || request.auth.uid in resource.data.members);
      allow list: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn() && request.resource.data.members is list && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members && request.resource.data.members[0] != request.resource.data.members[1]
        && request.resource.data.keys().hasOnly(['members','names','bookingId','createdAt']);
      allow update: if signedIn() && request.auth.uid in resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bookingId'])
        && request.resource.data.bookingId is string
        && get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.participants.hasAll(resource.data.members);
      allow delete: if false;
      match /messages/{messageId} {
        function chatMember() { return signedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(id)).data.members; }
        allow read: if chatMember();
        allow create: if chatMember() && request.resource.data.senderId == request.auth.uid
          && request.resource.data.keys().hasOnly(['senderId','text','attachment','createdAt']) && request.resource.data.text is string && request.resource.data.text.size() <= 2000;
        allow delete: if chatMember() && own(resource.data.senderId);
        allow update: if false;
      }
    }
    match /notifications/{id} {
      allow read, delete: if own(resource.data.userId);
      allow update: if own(resource.data.userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']) && request.resource.data.read is bool;
      allow create: if signedIn() && request.resource.data.actorId == request.auth.uid
        && request.resource.data.keys().hasOnly(['userId','actorId','type','bookingId','chatId','message','read','createdAt']) && request.resource.data.read == false && (
          request.resource.data.type == 'booking' && member(booking(request.resource.data.bookingId))
            && request.resource.data.userId in booking(request.resource.data.bookingId).participants
          || request.resource.data.type == 'message' && request.auth.uid in get(/databases/$(database)/documents/chats/$(request.resource.data.chatId)).data.members
            && request.resource.data.userId in get(/databases/$(database)/documents/chats/$(request.resource.data.chatId)).data.members);
    }
    match /reports/{id} {
      allow read: if own(resource.data.reporterId) || admin();
      allow create: if own(request.resource.data.reporterId) && member(booking(request.resource.data.bookingId))
        && request.resource.data.keys().hasOnly(['bookingId','reporterId','reason','details','evidence','status','createdAt'])
        && request.resource.data.status == 'submitted' && request.resource.data.details is string
        && request.resource.data.details.size() >= 10 && request.resource.data.details.size() <= 500;
      allow update, delete: if admin();
    }
  }
}
